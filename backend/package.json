{
  "name": "rag-transcriber-backend",
  "version": "1.0.0",
  "description": "Upload documents or audio/video, transcribe, and chat over them with RAG",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "rag",
    "langchain",
    "qdrant",
    "whisper",
    "transcription"
  ],
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/ollama": "^1.3.0",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "langchain": "^1.5.9",
    "multer": "^2.2.0",
    "nodejs-whisper": "^0.3.1",
    "openai": "^7.5.0",
    "pdf-parse": "^2.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
